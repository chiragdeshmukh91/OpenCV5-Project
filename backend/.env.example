# CLEARPATH backend configuration (all optional). The app reads environment variables only; it does NOT load
# this file automatically. Export them in your shell, or use this file as a systemd EnvironmentFile
# (deploy/aws/user-data.sh writes /etc/clearpath/clearpath.env in this format). Never put AWS keys here:
# boto3 uses its default credential chain (AWS_PROFILE / SSO / instance role via IMDSv2).

# --- vision service
VISION_MODE=local                      # local = OpenCV in-process; remote = call VISION_SERVICE_URL
VISION_SERVICE_URL=http://127.0.0.1:8100
# VISION_API_KEY=                      # shared secret between API and a separately hosted vision service
VISION_TIMEOUT_S=120
DETECTOR_CONF=0.35                     # YOLOX-S confidence threshold
DNN_THREADS=0                          # 0 = OpenCV default
# DETECTOR_MODEL=backend/models/yolox_s_2022nov.onnx
# WEAPON_MODEL=                        # optional dedicated weapon ONNX (YOLOX head); unset = capability unavailable

# --- agent
AGENT_MAX_STEPS=14                     # evidence budget (cameras + re-analyses)
AGENT_STEP_DELAY_S=0.35                # pause between trace steps so the UI can follow; 0 for tests
CORS_ORIGINS=*

# --- paths (defaults are inside backend/)
# CLEARPATH_DATA_DIR=backend/runtime   # run media (evidence frames)
# CLEARPATH_FOOTAGE_DIR=backend/footage
# CLEARPATH_MODELS_DIR=backend/models

# --- AWS (optional; nothing is called unless these are set)
# AWS_REGION=us-east-1
# CLEARPATH_S3_BUCKET=                 # run archives -> s3://<bucket>/runs/<run_id>.json; footage fallback
# CLEARPATH_CLOUDWATCH=0               # 1 = PutMetricData to namespace CLEARPATH_CW_NAMESPACE
# CLEARPATH_CW_NAMESPACE=CLEARPATH
# CLEARPATH_SKIP_IMDS=1                # skip EC2 metadata probes off AWS (faster startup)

# --- COOL verification (only when running against a COOL build)
# CLEARPATH_COOL_EXPECTED=0
# CLEARPATH_COOL_MARKER=
